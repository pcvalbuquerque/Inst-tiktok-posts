 "phrases": [
  {
   "t": "Seu cliente não acha você caro.",
   "s": 0.03,
   "e": 1.97
  },
  {
   "t": "Ele acha você igual.",
   "s": 2.25,
   "e": 3.75
  },
  {
   "t": "Olha essa prateleira.",
   "s": 4.27,
   "e": 5.11
  },
  {
   "t": "Mesmo produto, mesma embalagem, mesma promessa.",
   "s": 5.53,
   "e": 8.56
  },
  {
   "t": "Quando tudo parece igual, sobra um único jeito de escolher:",
   "s": 8.99,
   "e": 12.02
  },
  {
   "t": "o preço.",
   "s": 12.45,
   "e": 12.98
  },
  {
   "t": "E aí começa a guerra do desconto.",
   "s": 13.35,
   "e": 15.15
  },
  {
   "t": "Você baixa, o concorrente baixa,",
   "s": 15.39,
   "e": 17.25
  },
  {
   "t": "e no fim ninguém lucra.",
   "s": 17.58,
   "e": 18.95
  },
  {
   "t": "Agora repara.",
   "s": 19.35,
   "e": 20.06
  },
  {
   "t": "Quando um aparece diferente, a etiqueta para de importar.",
   "s": 20.44,
   "e": 23.57
  },
  {
   "t": "O cliente não pergunta mais quanto custa.",
   "s": 23.88,
   "e": 25.72
  },
  {
   "t": "Pergunta como compra.",
   "s": 25.97,
   "e": 27.24
  },
  {
   "t": "Ser diferente não é ser mais caro.",
   "s": 27.59,
   "e": 29.52
  },
  {
   "t": "É deixar de ser comparável.",
   "s": 29.79,
   "e": 31.24
  },
  {
   "t": "E o seu negócio?",
   "s": 31.61,
   "e": 32.33
  },
  {
   "t": "Tá na prateleira ou fora dela?",
   "s": 32.63,
   "e": 34.14
  },
  {
   "t": "Comenta aqui.",
   "s": 34.49,
   "e": 35.05
  }
